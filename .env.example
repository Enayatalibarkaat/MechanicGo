# Public configuration. Leave blank unless the feature is configured.
NEXT_PUBLIC_APP_NAME=MechanicGo

# Required for accounts, profiles, and bookings
MONGODB_URI=

# Required for real email OTP. Use a Google App Password, not your normal Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Required: long, random secret for signing OTP challenges and login sessions.
# Changing this value invalidates existing sessions and active OTP challenges.
OTP_SECRET=

# Required for booking alerts and private file storage
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Optional AI support. The support API falls back to a clearly labelled offline response without a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional number-plate lookup. Requires a legitimate provider/API account.
# The provider endpoint should accept POST JSON with registrationNumber and return vehicle/data fields.
VEHICLE_LOOKUP_API_URL=
VEHICLE_LOOKUP_API_KEY=

# Required to let your separate coupon website issue/update/disable coupons through the integration API.
# Generate a long random secret and keep it ONLY on server-side environments (never NEXT_PUBLIC_*).
COUPON_INTEGRATION_SECRET=
